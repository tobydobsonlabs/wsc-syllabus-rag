# WSC Syllabus RAG — environment variables
# Copy to `.env.local` and fill in. NEXT_PUBLIC_* are exposed to the browser; everything else is server-only.
# Never commit `.env.local`.

# --- Supabase (a NEW project, isolated from any other) -----------------------
# Project URL + anon key from Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, bypasses RLS. Used by ingest and the query route.
SUPABASE_SERVICE_ROLE_KEY=

# --- Voyage AI (embeddings) --------------------------------------------------
VOYAGE_API_KEY=
# Model + dimension. Must match between ingest and query. voyage-3.5-lite = 1024 dims.
VOYAGE_MODEL=voyage-3.5-lite
EMBED_DIM=1024

# --- Anthropic (generation) --------------------------------------------------
ANTHROPIC_API_KEY=
# Cheap + current for short grounded answers. Swap to claude-sonnet-5 for higher quality.
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Retrieval / guardrails --------------------------------------------------
# Cosine-similarity floor: below this, the app refuses instead of answering.
# Tuned by scripts/eval.ts against the golden set; see DECISIONS.md.
RELEVANCE_FLOOR=0.30
MATCH_COUNT=6
MAX_QUESTION_CHARS=400

# --- Ingest (local only; never runs in production) ---------------------------
# Absolute path to the WSC knowledge base whose notes get embedded.
# Points at the private source folder; nothing here is copied into the repo.
INGEST_SOURCE_DIR=C:/Users/Toby Dobson/english-connection/WSC

# --- Rate limiting (optional; Upstash free tier) -----------------------------
# If unset, the app falls back to an in-memory limiter (fine for a single instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
